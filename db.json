      "id": 1,
      "quizId": 1,
      "order": 1,
      "content": "She ____ to school by bus every day.",
      "options": [
        {
          "id": "A",
          "text": "go"
        },
        {
          "id": "B",
          "text": "goes"
        },
        {
          "id": "C",
          "text": "is going"
        },
        {
          "id": "D",
          "text": "going"
        }
      ],
      "correctOptionId": "B",
      "explanation": "Với chủ ngữ ngôi thứ ba số ít trong Present Simple, động từ thêm -s/-es.",
      "points": 1,
      "createdAt": "2026-07-03T08:10:00.000Z",
      "updatedAt": "2026-07-03T08:10:00.000Z"
    },
    {
      "id": 2,
      "quizId": 1,
      "order": 2,
      "content": "Look! The children ____ football in the garden.",
      "options": [
        {
          "id": "A",
          "text": "play"
        },
        {
          "id": "B",
          "text": "plays"
        },
        {
          "id": "C",
          "text": "are playing"
        },
        {
          "id": "D",
          "text": "is playing"
        }
      ],
      "correctOptionId": "C",
      "explanation": "“Look!” cho thấy hành động đang diễn ra, nên dùng Present Continuous: are playing.",
      "points": 1,
      "createdAt": "2026-07-03T08:11:00.000Z",
      "updatedAt": "2026-07-03T08:11:00.000Z"
    },
    {
      "id": 3,
      "quizId": 1,
      "order": 3,
      "content": "I usually ____ coffee, but today I ____ tea.",
      "options": [
        {
          "id": "A",
          "text": "drink / am drinking"
        },
        {
          "id": "B",
          "text": "am drinking / drink"
        },
        {
          "id": "C",
          "text": "drinks / am drinking"
        },
        {
          "id": "D",
          "text": "drink / drink"
        }
      ],
      "correctOptionId": "A",
      "explanation": "“Usually” dùng Present Simple; “today” mô tả tình huống tạm thời nên dùng Present Continuous.",
      "points": 1,
      "createdAt": "2026-07-03T08:12:00.000Z",
      "updatedAt": "2026-07-03T08:12:00.000Z"
    },
    {
      "id": 4,
      "quizId": 1,
      "order": 4,
      "content": "My brother ____ TV at the moment.",
      "options": [
        {
          "id": "A",
          "text": "watches"
        },
        {
          "id": "B",
          "text": "watch"
        },
        {
          "id": "C",
          "text": "is watching"
        },
        {
          "id": "D",
          "text": "are watching"
        }
      ],
      "correctOptionId": "C",
      "explanation": "“At the moment” là dấu hiệu của Present Continuous; chủ ngữ số ít dùng is.",
